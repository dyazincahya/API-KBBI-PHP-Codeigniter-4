#--------------------------------------------------------------------
# GEONODE SCRAPER API KEYS
#--------------------------------------------------------------------
# Konfigurasi kunci untuk GeoNode Scraper API. Mendukung multi-akun/kunci
# dengan mekanisme rotasi otomatis (round-robin) dan pembatas jatah lokal.
#
# Parameter per Kunci:
# - name      : Nama atau identitas akun (opsional, untuk penanda developer).
# - apikey    : API Key unik yang didapat dari GeoNode Dashboard.
# - limit     : Batas kuota request bulanan lokal (misal: 1499).
# - reset_day : Tanggal billing reset tiap bulannya (misal: 10).
#
geonode.apiKeys.0.name = 'Akun Utama'
geonode.apiKeys.0.apikey = 'MASUKKAN_API_KEY_ANDA_DI_SINI'
geonode.apiKeys.0.limit = 1499
geonode.apiKeys.0.reset_day = 10

